# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dados reais do cliente (planilhas, extratos) nunca entram no repositório
/dados-reais/
*.xlsx
*.ofx
# exceção: extrato fictício para a demonstração
!docs/demo/*.ofx

# worktrees das sessões paralelas
/.claude/worktrees/

# permissões locais do Claude Code (de cada máquina)
/.claude/settings.local.json
